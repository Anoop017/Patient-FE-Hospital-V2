# ==========================================
# Patient Portal - Environment Variables Template
# ==========================================

# NestJS Core Backend (Auth, Patients, Appointments, Medical Records, Prescriptions, Beds)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Go Microservice (PDF Report Generation & Telemetry HTTP endpoints)
# When deployed behind Nginx reverse proxy: http://<EC2_HOST>/go
# When running standalone locally: http://localhost:4000
NEXT_PUBLIC_GO_SERVICE_URL=http://localhost:4000

# Go Microservice (Real-time ICU Vitals WebSocket Stream)
# When deployed behind Nginx reverse proxy: ws://<EC2_HOST>/go/api/v1/ws/vitals
# When running standalone locally: ws://localhost:4000/api/v1/ws/vitals
NEXT_PUBLIC_WS_URL=ws://localhost:4000/api/v1/ws/vitals

# Demo Credentials (Optional for local development login quick-fill)
NEXT_PUBLIC_DEMO_DOCTOR_EMAIL=doctor@example.com
NEXT_PUBLIC_DEMO_DOCTOR_PASSWORD=password123

NEXT_PUBLIC_DEMO_PATIENT_EMAIL=patient@example.com
NEXT_PUBLIC_DEMO_PATIENT_PASSWORD=password123

NEXT_PUBLIC_DEMO_STAFF_EMAIL=staff@example.com
NEXT_PUBLIC_DEMO_STAFF_PASSWORD=password123
