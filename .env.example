# ==========================================
# Patient Portal - Environment Variables Template
# ==========================================

# NestJS Core Backend
# Production / Staging: https://api.anoopsnair.online/api/v1
# Local Development: http://localhost:3000/api/v1
NEXT_PUBLIC_API_URL=https://api.anoopsnair.online/api/v1

# Go Microservice (PDF Report Generation & Telemetry HTTP endpoints)
# Production / Staging: https://go.anoopsnair.online
# Local Development: http://localhost:4000
NEXT_PUBLIC_GO_SERVICE_URL=https://go.anoopsnair.online

# Go Microservice (Real-time ICU Vitals Secure WebSocket Stream)
# Production / Staging: wss://go.anoopsnair.online/api/v1/ws/vitals
# Local Development: ws://localhost:4000/api/v1/ws/vitals
NEXT_PUBLIC_WS_URL=wss://go.anoopsnair.online/api/v1/ws/vitals

# Demo Credentials (Optional for local development login quick-fill)
NEXT_PUBLIC_DEMO_DOCTOR_EMAIL=doctor@example.com
NEXT_PUBLIC_DEMO_DOCTOR_PASSWORD=password123

NEXT_PUBLIC_DEMO_PATIENT_EMAIL=patient@example.com
NEXT_PUBLIC_DEMO_PATIENT_PASSWORD=password123

NEXT_PUBLIC_DEMO_STAFF_EMAIL=staff@example.com
NEXT_PUBLIC_DEMO_STAFF_PASSWORD=password123
